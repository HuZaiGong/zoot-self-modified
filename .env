DEEPSEEK_API_KEY=your_api_key_here

# 长短问询时间（秒）
SHORT_DURATION=30
LONG_DURATION=60
MAX_GROUP_ROUNDS=1

# 记忆分层
SHORT_TERM_LIMIT=20
MID_TERM_MAX=10
MID_TERM_COMPRESS_INTERVAL=300
LONG_TERM_MAX=50
LONG_TERM_DB_PATH=memories.db

# NLP状态跟踪（默认关闭）
ENABLE_NLP_STATE_TRACKING=false
NLP_MODEL=zh_core_web_sm

# 向量检索（默认关闭）
ENABLE_VECTOR_RETRIEVAL=false
VECTOR_RETRIEVAL_COUNT=5

# 主动发言间隔
ACTIVE_INTERVAL=30

# 分段回复
ENABLE_SPLIT_REPLY=true
SPLIT_DELAY=2
SPLIT_SEPARATOR=|

# 日志
LOG_LEVEL=DEBUG                 # 记录 DEBUG 及以上级别
LOG_FILE=logs/app.log            # 日志文件路径（相对或绝对）
LOG_MAX_BYTES=10485760           # 10MB
LOG_BACKUP_COUNT=5

# API
KNOWLEDGE_SERVICE_URL=https://kiiinou.cn
KNOWLEDGE_SERVICE_API_KEY=XgnofMFbBbiuaPf6EeUr4ijTtmBA2mDX